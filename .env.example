# Lumori connects to the installed Codex, authenticated with ChatGPT.
APP_PASSWORD=
SESSION_SECRET=
CODEX_WS_URL=ws://127.0.0.1:8091
CODEX_WS_TOKEN=
CODEX_MODEL=gpt-5.6-sol
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
WORKSPACE_DIR=./workspaces
TURN_TIMEOUT_MS=900000
MAX_STORAGE_MB=512
# Optional local CPU speech recognition (no API)
SPEECH_PYTHON=
SPEECH_MODEL_PATH=
# Behind an HTTPS reverse proxy:
# APP_ORIGIN=https://chat.example.com
COOKIE_SECURE=false
TRUST_PROXY=false

# Optional second account (Karina), at least 12 characters
KARINA_PASSWORD=
